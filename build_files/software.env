# Pasiv Black Box v1 software declaration.
#
# Keep host-native software focused on physical-host administration,
# networking, power/UPS integration, diagnostics, and the Cockpit bridge.
# Replaceable monitoring applications belong in Quadlets instead.

PASIV_BLACK_BOX_PACKAGES="\
NetworkManager \
NetworkManager-tui \
NetworkManager-wifi \
systemd-resolved \
firewalld \
openssh-server \
sudo \
nut \
nut-client \
libusb1-devel \
pcp \
pcp-pmda-openmetrics \
pcp-system-tools \
net-snmp-utils \
wireguard-tools \
fwupd \
fwupd-efi \
amd-ucode-firmware \
amd-gpu-firmware \
microcode_ctl \
intel-gpu-firmware \
iwlegacy-firmware \
iwlwifi-dvm-firmware \
iwlwifi-mvm-firmware \
atheros-firmware \
realtek-firmware \
qemu-guest-agent \
smartmontools \
fastfetch \
zram-generator \
lm_sensors \
nvme-cli \
usbutils \
pciutils \
ethtool \
powertop \
btop \
micro \
nano \
vim-enhanced \
tmux \
jq \
rsync \
tcpdump \
bind-utils \
traceroute \
nmap-ncat \
iperf3 \
openssl \
curl \
lsof \
file \
unzip \
policycoreutils-python-utils \
selinux-policy-extra \
cockpit-system \
cockpit-files \
cockpit-podman \
cockpit-storaged"

TAILSCALE_PACKAGE="tailscale"
NETBIRD_PACKAGE="netbird"

# Cockpit web service stays containerized. Alma's cockpit-system package provides
# the bridge plus system, networking, and SELinux interfaces; separate native
# packages add the files, Podman, and storage pages. The Quadlet follows the
# upstream Cockpit web-service latest tag.
COCKPIT_WS_IMAGE="quay.io/cockpit/ws:latest"
