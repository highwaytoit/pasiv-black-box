{
  "gateway": {
    "mode": "local",
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openai/gpt-5.6-sol"
      },
      "heartbeat": {
        "every": "0m"
      }
    }
  },
  "tools": {
    "profile": "minimal",
    "deny": [
      "gateway"
    ],
    "elevated": {
      "enabled": false
    }
  },
  "plugins": {
    "entries": {
      "browser": {
        "enabled": false
      },
      "memory-core": {
        "config": {
          "dreaming": {
            "enabled": false
          }
        }
      }
    }
  },
  "skills": {
    "workshop": {
      "autonomous": {
        "mode": "off"
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "allowlist",
      "allowFrom": [
        "REPLACE_WITH_NUMERIC_TELEGRAM_USER_ID"
      ],
      "groupPolicy": "disabled"
    }
  },
  "commands": {
    "ownerAllowFrom": [
      "telegram:REPLACE_WITH_NUMERIC_TELEGRAM_USER_ID"
    ]
  }
}
