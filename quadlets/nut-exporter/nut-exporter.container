[Unit]
Description=NUT Exporter for Pasiv Black Box
Requires=pasiv-monitoring-network.service
After=pasiv-monitoring-network.service
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/druggeri/nut_exporter:3.3.0
ContainerName=nut-exporter
Network=host
Exec=--nut.server=127.0.0.1 --nut.serverport=3493 --nut.disable_device_info --nut.vars_enable=battery.charge,battery.runtime,battery.voltage,input.voltage,output.voltage,ups.load,ups.status --web.listen-address=@@NUT_EXPORTER_LISTEN_ADDRESS@@:9199

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
