# Copy to /etc/pasiv-black-box/n8n/n8n.env.
# Never commit real secret values or deployment-specific hostnames.
N8N_ENCRYPTION_KEY=REPLACE_WITH_64_CHARACTER_HEX_KEY
N8N_HOST=n8n.example.com
N8N_PORT=5678
N8N_LISTEN_ADDRESS=0.0.0.0
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://n8n.example.com:8443/
N8N_WEBHOOK_URL=https://n8n.example.com:8443/
N8N_PROXY_HOPS=1
N8N_SECURE_COOKIE=true
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_BLOCK_ENV_ACCESS_IN_NODE=true
N8N_BLOCK_FILE_ACCESS_TO_N8N_FILES=true
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_HIRING_BANNER_ENABLED=false
N8N_TEMPLATES_ENABLED=false
N8N_COMMUNITY_PACKAGES_ENABLED=false
N8N_UNVERIFIED_PACKAGES_ENABLED=false
N8N_PUBLIC_API_DISABLED=true
N8N_METRICS=false
GENERIC_TIMEZONE=UTC
TZ=UTC
